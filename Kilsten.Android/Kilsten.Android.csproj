<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Kilsten.Android</AssemblyName>
    <RootNamespace>Kilsten.Android</RootNamespace>
    <Authors>Andrew Johnson</Authors>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0</AssemblyVersion>
    <FileVersion>2.0.0</FileVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <AssemblyTitle>Kilsten.Android</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Resources\values\_strings.xml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.8.0" />
    <PackageReference Include="Xamarin.AndroidX.ViewPager" Version="1.1.0.7" />
  </ItemGroup>
</Project>