<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:deviceIds="wear"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_gravity="center_vertical"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:fadeScrollbars="false"
    android:background="@color/_kilsten_wear_wearable_backgroundOpaque">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center|top"
        android:paddingLeft="@dimen/_kilsten_wear_wearable_marginSizeSmall"
        android:paddingRight="@dimen/_kilsten_wear_wearable_marginSizeSmall"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <TextView
            android:id="@+id/_kilsten_wear_titleTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            style="@android:style/TextAppearance.Medium"
            android:textStyle="bold"
            android:singleLine="false"
            android:breakStrategy="balanced"
            android:hyphenationFrequency="full"
            app:layout_constraintTop_toTopOf="parent"
            android:paddingTop="@dimen/_kilsten_wear_wearable_marginSizeLarge2"
            android:paddingBottom="@dimen/_kilsten_wear_wearable_marginSizeMedium"
            android:paddingLeft="@dimen/_kilsten_wear_wearable_marginSizeLarge"
            android:paddingRight="@dimen/_kilsten_wear_wearable_marginSizeLarge"/>
        <TextView
            android:id="@+id/_kilsten_wear_messageTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            style="@android:style/TextAppearance.Medium"
            android:singleLine="false"
            android:breakStrategy="balanced"
            android:hyphenationFrequency="full"
            app:layout_constraintTop_toBottomOf="@id/_kilsten_wear_titleTv"
            android:paddingBottom="@dimen/_kilsten_wear_wearable_marginSizeMedium"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/_kilsten_wear_messageTv"
            android:paddingBottom="@dimen/_kilsten_wear_wearable_marginSizeLarge">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/_kilsten_wear_negativeBtn"
                android:layout_width="@dimen/_kilsten_wear_wearable_buttonSize"
                android:layout_height="@dimen/_kilsten_wear_wearable_buttonSize"
                android:layout_marginLeft="@dimen/_kilsten_wear_wearable_marginSizeSmall"
                android:layout_marginRight="@dimen/_kilsten_wear_wearable_marginSizeSmall"
                android:scaleType="center"
                android:src="@drawable/_kilsten_wear_ic_close"
                android:background="@drawable/_kilsten_wear_button_round"
                android:tooltipText="@android:string/cancel"
                android:contentDescription="@android:string/cancel"/>
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/_kilsten_wear_positiveBtn"
                android:layout_width="@dimen/_kilsten_wear_wearable_buttonSize"
                android:layout_height="@dimen/_kilsten_wear_wearable_buttonSize"
                android:layout_marginLeft="@dimen/_kilsten_wear_wearable_marginSizeSmall"
                android:layout_marginRight="@dimen/_kilsten_wear_wearable_marginSizeSmall"
                android:scaleType="center"
                android:src="@drawable/_kilsten_wear_ic_done"
                android:background="@drawable/_kilsten_wear_button_round"
                android:backgroundTint="?android:attr/colorAccent"
				android:tooltipText="@android:string/ok"
                android:contentDescription="@android:string/ok"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
